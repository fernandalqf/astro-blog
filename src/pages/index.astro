---
import Layout from '../layouts/Layout.astro';
import { supabase } from '../lib/supabaseClient.js';

// Search the last 5 posts (newest first)
const { data: posts, error } = await supabase
  .from('posts')
  .select('id, title, content, created_at')
  .order('created_at', { ascending: false })
  .limit(5);
---

<Layout>
  <h1 class="mb-6 text-4xl font-bold text-blue-500">
    Latest Posts
  </h1>

  {error && (
    <p class="text-red-600">
      Error loading posts
    </p>
  )}

  {!error && posts?.length === 0 && (
    <p class="text-gray-500">
      No posts published yet.
    </p>
  )}

  <div class="space-y-4">
    {posts?.map((post) => (
      <a
        href={`/posts/${post.id}`}
        class="block rounded border p-4 transition hover:bg-gray-50"
      >
        <h2 class="text-xl font-semibold">
          {post.title}
        </h2>

        <p class="mt-2 text-gray-700">
          {post.content.slice(0, 150)}...
        </p>

        <p class="mt-2 text-xs text-gray-400">
          {new Date(post.created_at).toLocaleDateString()}
        </p>
      </a>
    ))}
  </div>

  <!-- Floating + button -->
  <a
    href="/dashboard"
    class="fixed bottom-6 right-6 flex h-14 w-14 items-center justify-center
           rounded-full bg-blue-600 text-3xl font-bold text-white
           shadow-lg transition hover:bg-blue-700"
    aria-label="Create post"
  >
    +
  </a>
</Layout>
